<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000" android:keepScreenOn="true">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <com.example.signtest.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:background="#CC000000" android:padding="12dp">

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="วางมือในกรอบเขียว" android:textColor="#FFFFFF"
            android:textSize="28sp" android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTop3"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#DDDDDD" android:textSize="15sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#88FF88" android:textSize="12sp"
            android:fontFamily="monospace" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button
                android:id="@+id/btnSwitch"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="สลับกล้อง" />
            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="ล้างบัฟเฟอร์" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
